# =====================================================================
# DataFud — Variables de entorno
# Copia este archivo como .env.local y completa con tus credenciales de Supabase.
# Las encuentras en: Supabase Dashboard -> Project Settings -> API
# =====================================================================

# URL del proyecto Supabase (ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anónima (publishable / anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service role (SOLO server-side, nunca exponer al cliente)
# Hoy la usa solo createTenant (alta de un local desde el super admin).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para construir enlaces de QR). En local: http://localhost:3000
# En producción: https://datafud.com. No es secreta: el valor local queda puesto porque los QR
# del panel no tienen otro respaldo si la variable llega vacía.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto de la landing (Resend). Sin esta clave el formulario NO se muestra
# y la sección de contacto ofrece solo WhatsApp (D-039: ningún correo se muestra). Crear la clave en resend.com.
RESEND_API_KEY=
# Remitente con dominio VERIFICADO en Resend (ej. "DataFud <hola@datafud.com>").
# Vacío = "DataFud <onboarding@resend.dev>", que SOLO entrega al correo dueño de la cuenta de
# Resend: para recibir leads reales hay que verificar el dominio y completar esta variable.
RESEND_FROM_EMAIL=

# Cloudflare Turnstile (opcional) para el formulario de contacto. Solo con las DOS variables se
# carga el widget y se verifica el token en el servidor; sin ellas el formulario funciona igual
# (honeypot + sello de tiempo firmado + tope de enlaces + tope de envíos por IP). El sello se firma
# con una clave derivada de RESEND_API_KEY: no hace falta otra variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Meta Pixel (opcional) para medir campañas en Facebook e Instagram. Solo el ID numérico del
# píxel. Vacío = no se carga nada de facebook.net. Cambiarlo en Vercel exige redesplegar.
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------------------------
# Solo scripts locales (no van a Vercel). Se pasan en la línea de comandos al correr el script.
# ---------------------------------------------------------------------------------------------
# scripts/prueba-aislamiento.mjs: dos cuentas de prueba de locales distintos.
AISLAMIENTO_A_EMAIL=
AISLAMIENTO_A_PASSWORD=
AISLAMIENTO_B_EMAIL=
AISLAMIENTO_B_PASSWORD=
# scripts/qa-landing.mjs: URL a probar (vacío = la de por defecto del script) y Chromium propio.
QA_BASE=
QA_CHROMIUM=
# scripts/carta-kit.mjs: ruta a un Chromium propio (vacío = el de Playwright).
KIT_CHROMIUM=
