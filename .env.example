# =====================================================================
# Datfud — Variables de entorno
# Copia este archivo como .env.local y completa con tus credenciales de Supabase.
# Las encuentras en: Supabase Dashboard -> Project Settings -> API
# =====================================================================

# URL del proyecto Supabase (ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Clave pública anónima (publishable / anon key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Clave service role (SOLO server-side, nunca exponer al cliente)
# Se usa para acciones administrativas (registrar tenants, etc.)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# URL pública del sitio (para construir enlaces de QR). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto de la landing (Resend). Sin esta clave el formulario NO se muestra
# y la sección de contacto ofrece solo WhatsApp y correo. Crear la clave en resend.com.
RESEND_API_KEY=
# Remitente opcional con dominio verificado en Resend (ej. "DataFud <hola@datafud.com>").
# Vacío = "DataFud <onboarding@resend.dev>", que solo entrega al correo dueño de la cuenta.
RESEND_FROM_EMAIL=

# Cloudflare Turnstile (opcional) para el formulario de contacto. Solo con las DOS variables se
# carga el widget y se verifica el token en el servidor; sin ellas el formulario funciona igual
# (honeypot + trampa de tiempo + tope de enlaces).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
